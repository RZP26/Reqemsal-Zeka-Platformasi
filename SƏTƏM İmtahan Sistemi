const PAGE_SIZE = 20, KEY = 'setem-exam-v1';
let state;
function fresh(){ return { remaining: shuffle(questions.map(q=>q.id)), wrongQueue:[], current:[], answers:{}, totalCorrect:0, totalWrong:0, completed:false }; }
function shuffle(a){ for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]} return a; }
function save(){ localStorage.setItem(KEY,JSON.stringify(state)); }
function getQuestion(id){ return questions.find(q=>q.id===id); }
function nextPage(){ state.answers={}; const ids=[]; while(ids.length<PAGE_SIZE && state.wrongQueue.length) ids.push(state.wrongQueue.shift()); while(ids.length<PAGE_SIZE && state.remaining.length) ids.push(state.remaining.shift()); state.current=ids; save(); render(); }
function render(){ const root=document.getElementById('exam'); if(!state.current.length){ root.innerHTML=state.completed ? completedView() : '<div class="empty"><strong>Hazırda təkrar sual qalmayıb.</strong><br><button onclick="finish()" style="margin-top:16px">Yekun nəticəni göstər</button></div>'; return; }
 const answered=Object.keys(state.answers).length, progress=answered/state.current.length*100;
 root.innerHTML=`<div class="status"><div><strong>Aktiv mərhələ: ${state.current.length} sual</strong><div style="color:var(--muted);margin-top:3px">Sual bazasında ${state.remaining.length} yeni sual qalıb${state.wrongQueue.length?`, ${state.wrongQueue.length} təkrar sual növbədədir`:''}.</div></div><span class="badge">${answered} / ${state.current.length} cavablandırılıb</span></div><div class="progress"><i style="width:${progress}%"></i></div><form id="form">${state.current.map((id,index)=>questionView(getQuestion(id),index)).join('')}<div class="actions"><button type="submit" ${answered===state.current.length?'':'disabled'}>Cavabları yoxla</button><p class="hint">Bütün suallar cavablandırıldıqda yoxlama açılacaq.</p></div></form>`;
 document.getElementById('form').addEventListener('change',e=>{if(e.target.name){state.answers[e.target.name]=e.target.value;save();render();}}); document.getElementById('form').addEventListener('submit',submitPage);
}
function questionView(q,index){return `<article class="question"><div class="qhead"><span>${index+1}. sual · Baza №${q.id}</span>${state.wrongQueue.includes(q.id)?'<span class="repeat">Təkrar öyrənmə</span>':''}</div><h2>${escapeHtml(q.text)}</h2><div class="options">${Object.entries(q.options).map(([key,value])=>`<label class="option"><input type="radio" name="${q.id}" value="${key}" ${state.answers[q.id]===key?'checked':''}><strong>${key})</strong> ${escapeHtml(value)}</label>`).join('')}</div></article>`}
function submitPage(e){e.preventDefault();const wrong=[];let correct=0;const details=[];for(const id of state.current){const q=getQuestion(id),chosen=state.answers[id],ok=chosen===q.answer;if(ok){correct++;state.totalCorrect++}else{wrong.push(id);state.totalWrong++;details.push({q,chosen})}}state.wrongQueue.push(...wrong);state.current=[];save();showPageResult(correct,details);}
function showPageResult(correct,details){const root=document.getElementById('exam');const total=correct+details.length;root.innerHTML=`<h2>Bu mərhələnin nəticəsi</h2><div class="result good"><strong>Düzgün cavablar: ${correct} / ${total}</strong></div>${details.length?`<div class="result bad"><strong>Səhv cavablar: ${details.length}</strong><br>Bu suallar növbəti mərhələyə əlavə edildi. Düzgün variantlar aşağıdadır.</div><div class="answers">${details.map(({q,chosen})=>`<article class="answer"><strong>Baza №${q.id}: ${escapeHtml(q.text)}</strong><p>Sizin cavabınız: <b>${chosen}) ${escapeHtml(q.options[chosen])}</b></p><p>Düzgün cavab: <b>${q.answer}) ${escapeHtml(q.options[q.answer])}</b></p></article>`).join('')}</div>`:'<p class="result good">Əla! Bu mərhələdə bütün cavablar düzgündür.</p>'}<div class="actions"><button onclick="goNext()">${state.remaining.length||state.wrongQueue.length?'Növbəti 20 sual':'Yekun nəticəni göstər'}</button><button class="secondary" onclick="restart()">İmtahanı sıfırla</button></div>`;}
function goNext(){if(state.remaining.length||state.wrongQueue.length)nextPage();else finish();}function finish(){state.completed=true;save();render();}function completedView(){const attempts=state.totalCorrect+state.totalWrong;return `<div class="empty"><h2>İmtahan tamamlandı</h2><p><b>${state.totalCorrect}</b> düzgün, <b>${state.totalWrong}</b> səhv cavab cəhdi.</p><p>Hər səhv sual düzgün cavablandırılanadək yenidən təqdim olunub.</p><button onclick="restart()">Yeni imtahana başla</button></div>`}function restart(){if(confirm('Mövcud nəticələri silib yeni imtahana başlamaq istəyirsiniz?')){state=fresh();nextPage();}}function escapeHtml(s){return String(s).replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));}
try{state=JSON.parse(localStorage.getItem(KEY))||fresh()}catch{state=fresh()} if(!state.current.length&&!state.completed)nextPage();else render();
</script>
</body></html>
